{"kind":"bigquery#job","etag":"RUV6rUGSKL8ZRViQXsAWow==","id":"nl2sparql-thesis:US.","selfLink":"https://bigquery.googleapis.com/bigquery/v2/projects/nl2sparql-thesis/jobs/?location=US","user_email":"ahkhoats@gmail.com","configuration":{"query":{"query":"WITH transfer_counts AS (SELECT transaction_hash AS transaction_hash, block_number AS block_number, block_hash AS block_hash, COUNT(*) AS transfer_count FROM `nl2sparql-thesis.nl2sparql_analytics.token_transfer_facts`(DATE '2026-06-01', DATE '2026-06-08') GROUP BY transaction_hash, block_number, block_hash) SELECT tx.transaction_hash AS transaction_hash, tx.value_wei AS native_value_wei, transfer_counts.transfer_count AS transfer_count FROM `nl2sparql-thesis.nl2sparql_analytics.transaction_facts`(DATE '2026-06-01', DATE '2026-06-08') AS tx JOIN transfer_counts ON tx.transaction_hash = transfer_counts.transaction_hash AND tx.block_number = transfer_counts.block_number AND tx.block_hash = transfer_counts.block_hash ORDER BY transfer_count DESC, native_value_wei DESC, transaction_hash ASC LIMIT 10","destinationTable":{"projectId":"nl2sparql-thesis","datasetId":"_36a19d4c7419dee082756ffb20166d3df916457c","tableId":"anon39c238ce_7ef8_426f_a6ea_ca971a054018"},"writeDisposition":"WRITE_TRUNCATE","priority":"INTERACTIVE","useQueryCache":false,"maximumBytesBilled":"25769803776","useLegacySql":false},"dryRun":true,"jobType":"QUERY"},"jobReference":{"projectId":"nl2sparql-thesis","location":"US"},"statistics":{"creationTime":"1792826409159","endTime":"1792826409674","totalBytesProcessed":"21323694030","query":{"totalBytesProcessed":"21323694030","totalBytesBilled":"0","cacheHit":false,"schema":{"fields":[{"name":"transaction_hash","type":"STRING","mode":"NULLABLE"},{"name":"native_value_wei","type":"NUMERIC","mode":"NULLABLE"},{"name":"transfer_count","type":"INTEGER","mode":"NULLABLE"}]},"statementType":"SELECT","totalBytesProcessedAccuracy":"UPPER_BOUND","referencedRoutines":[{"projectId":"nl2sparql-thesis","datasetId":"nl2s