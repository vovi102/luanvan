      "sql": "WITH movements AS (\n  SELECT from_owner AS owner, 'outgoing' AS direction, value_wei\n  FROM `nl2sparql-thesis.nl2sparql_analytics.labeled_transactions`(DATE '2026-06-15', DATE '2026-06-16')\n  WHERE from_address_role = 'treasury' AND from_owner IS NOT NULL\n    AND receipt_status = 1 AND value_wei > 0\n  UNION ALL\n  SELECT to_owner AS owner, 'incoming' AS direction, value_wei\n  FROM `nl2sparql-thesis.nl2sparql_analytics.labeled_transactions`(DATE '2026-06-15', DATE '2026-06-16')\n  WHERE to_address_role = 'treasury' AND to_owner IS NOT NULL\n    AND receipt_status = 1 AND value_wei > 0\n), owner_stats AS (\n  SELECT owner,\n    SUM(IF(direction = 'incoming', value_wei, NUMERIC '0')) AS incoming_value_wei,\n    SUM(IF(direction = 'outgoing', value_wei, NUMERIC '0')) AS outgoing_value_wei,\n    COUNTIF(direction = 'incoming') AS incoming_transaction_count,\n    COUNTIF(direction = 'outgoing') AS outgoing_transaction_count\n  FROM movements\n  GROUP BY owner\n)\nSELECT owner, incoming_value_wei, outgoing_value_wei,\n  incoming_value_wei - outgoing_value_wei AS net_value_wei,\n  incoming_transaction_count, outgoing_transaction_count,\n  DENSE_RANK() OVER (ORDER BY ABS(incoming_value_wei - outgoing_value_wei) DESC) AS net_flow_rank\nFROM owner_stats\nORDER BY net_flow_rank, owner\nLIMIT 3"
