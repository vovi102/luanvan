      "sql": "WITH funding AS (\n  SELECT transaction_hash, block_timestamp, to_address, value_wei\n  FROM `nl2sparql-thesis.nl2sparql_analytics.labeled_transactions`(DATE '2026-06-15', DATE '2026-06-16')\n  WHERE to_address IS NOT NULL AND from_address_role = 'treasury' AND value_wei > 0\n), transfers AS (\n  SELECT transaction_hash, log_index, block_timestamp, from_address, token_symbol, normalized_amount\n  FROM `nl2sparql-thesis.nl2sparql_analytics.labeled_token_transfers`(DATE '2026-06-15', DATE '2026-06-16')\n)\nSELECT funding.transaction_hash AS funding_hash, transfers.transaction_hash AS transfer_hash,\n  transfers.log_index, funding.to_address AS funded_address, funding.value_wei AS funding_value_wei,\n  transfers.token_symbol, transfers.normalized_amount\nFROM funding\nJOIN transfers ON transfers.from_address = funding.to_address\n  AND transfers.block_timestamp >= funding.block_timestamp\n  AND transfers.block_timestamp < TIMESTAMP_ADD(funding.block_timestamp, INTERVAL 60 MINUTE)\nORDER BY transfers.block_timestamp, funding.transaction_hash, transfers.transaction_hash, transfers.log_index\nLIMIT 1"
