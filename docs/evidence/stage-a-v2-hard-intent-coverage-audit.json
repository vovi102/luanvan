      "sql": "SELECT DATE(block_timestamp) AS activity_date,\n  COUNTIF(from_address_role = 'treasury') AS treasury_outgoing_count,\n  COUNTIF(to_address_role = 'treasury') AS treasury_incoming_count,\n  COUNTIF(from_address_role = 'treasury' AND value_wei > 0) AS positive_native_funding_count,\n  COUNTIF(from_address_role = 'treasury' AND from_category = 'exchange'\n    AND to_address_role = 'operational' AND to_concept_class = 'DEXProtocol') AS exchange_to_dex_count,\n  COUNTIF(from_address_role = 'treasury' AND to_address_role = 'treasury'\n    AND from_owner != to_owner) AS cross_exchange_count,\n  COUNTIF(from_address_role = 'treasury' AND to_address_role = 'operational'\n    AND to_concept_class = 'BridgeProtocol') AS bridge_deposit_count\nFROM `nl2sparql-thesis.nl2sparql_analytics.labeled_transactions`(DATE '2026-06-01', DATE '2026-07-01')\nGROUP BY activity_date\nORDER BY activity_date"
