{"kind":"bigquery#job","etag":"CMRp56dC2JAjxPY9+oNd/Q==","id":"nl2sparql-thesis:US.","selfLink":"https://bigquery.googleapis.com/bigquery/v2/projects/nl2sparql-thesis/jobs/?location=US","user_email":"ahkhoats@gmail.com","configuration":{"query":{"query":"SELECT labels.concept_class AS sender_concept_class, COUNT(*) AS transaction_count, COALESCE(SUM(tx.value_wei), 0) AS total_value_wei FROM `nl2sparql-thesis.nl2sparql_analytics.transaction_facts`(DATE '2026-06-15', DATE '2026-06-22') AS tx JOIN `nl2sparql-thesis.nl2sparql_analytics.entity_labels_v1` AS labels ON tx.from_address = labels.address GROUP BY sender_concept_class ORDER BY total_value_wei DESC, sender_concept_class ASC LIMIT 10","destinationTable":{"projectId":"nl2sparql-thesis","datasetId":"_36a19d4c7419dee082756ffb20166d3df916457c","tableId":"anon2496eb0f_1bbc_449d_8243_f253123ecba0"},"writeDisposition":"WRITE_TRUNCATE","priority":"INTERACTIVE","useQueryCache":false,"maximumBytesBilled":"25769803776","useLegacySql":false},"dryRun":true,"jobType":"QUERY"},"jobReference":{"projectId":"nl2sparql-thesis","location":"US"},"statistics":{"creationTime":"1792827263541","endTime":"1792827263879","totalBytesProcessed":"1282101455","query":{"totalBytesProcessed":"1282101455","totalBytesBilled":"0","cacheHit":false,"referencedTables":[{"projectId":"nl2sparql-thesis","datasetId":"nl2sparql_analytics","tableId":"entity_labels_snapshot_cdc7856df81f"}],"schema":{"fields":[{"name":"sender_concept_class","type":"STRING","mode":"NULLABLE"},{"name":"transaction_count","type":"INTEGER","mode":"NULLABLE"},{"name":"total_value_wei","type":"NUMERIC","mode":"NULLABLE"}]},"statementType":"SELECT","totalBytesProcessedAccuracy":"UPPER_BOUND","referencedRoutines":[{"projectId":"nl2sparql-thesis","datasetId":"nl2sparql_analytics","routineId":"transaction_facts"}],"referencedLogicalViews":[{"projectId":"nl2sparql-thesis","datasetId":"nl2sparql_analytics","tableId":"entity_labels_v1"},{"projectId":"bigquery-public-data","datasetId":"cr