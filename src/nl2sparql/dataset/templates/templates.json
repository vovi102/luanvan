  {
    "id": "T_FILTER_TX_BY_VALUE",
    "name": "Transactions above value threshold",
    "category": "simple_filter",
    "difficulty": "easy",
    "slots": {
      "value_wei": {
        "type": "decimal_wei",
        "default_range": [
          "1000000000000000000",
          "1000000000000000000000"
        ]
      },
      "n": {
        "type": "integer",
        "default_range": [
          5,
          100
        ]
      }
    },
    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT ?tx ?value WHERE {{\n  ?tx a :Transaction ; :hasValue ?value .\n  FILTER(?value >= {value_wei})\n}} ORDER BY DESC(?value) LIMIT {n}",
    "nl_seed": "Which {n} transactions transferred at least {value_wei} wei?",
    "expected_columns": [
      "tx",
      "value"
    ],
    "ontology_elements": [
      ":Transaction",
      ":hasValue"
    ],
    "example_fill": {
      "start_date": "2024-01-01",
      "end_date": "2024-02-01",
      "n": 10,
      "value_wei": "1000000000000000000",
      "gas_used": 500000,
      "account": "<https://thesis.example.org/eth-kg/addr/0x1111111111111111111111111111111111111111>",
      "account_b": "<https://thesis.example.org/eth-kg/addr/0x2222222222222222222222222222222222222222>",
      "tx": "<https://thesis.example.org/eth-kg/tx/0xtx1>",
      "block_number": 19000000,
      "token_symbol": "USDC",
      "owner": "Binance",
      "category": "exchange",
      "concept_class": "ExchangeAccount",
      "window_minutes": 30
    }
  },
