          "2024-12-31"
        ],
        "constraint": "after start_date"
      },
      "n": {
        "type": "integer",
        "default_range": [
          5,
          100
        ]
      }
    },
    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT ?from ?to (COUNT(?tx) AS ?count) WHERE {{\n  ?tx a :Transaction ; :hasFrom ?from ; :hasTo ?to ; :hasTimestamp ?timestamp .\n  FILTER(?timestamp >= \"{start_date}T00:00:00Z\"^^xsd:dateTime)\n  FILTER(?timestamp < \"{end_date}T00:00:00Z\"^^xsd:dateTime)\n}} GROUP BY ?from ?to HAVING(COUNT(?tx) > 1) ORDER BY DESC(?count) LIMIT {n}",
    "nl_seed": "Which account pairs transacted repeatedly between {start_date} and {end_date}?",
