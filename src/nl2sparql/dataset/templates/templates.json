    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT ?from ?to ?value ?timestamp WHERE {{\n  {tx} a :Transaction ; :hasFrom ?from ; :hasValue ?value ; :hasTimestamp ?timestamp .\n  OPTIONAL {{ {tx} :hasTo ?to . }}\n}}",
    "nl_seed": "Show sender, recipient, value, and timestamp for transaction {tx}.",
    "expected_columns": [
      "from",
      "to",
      "value",
      "timestamp"
