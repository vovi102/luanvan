  {
    "id": "T_TOP_SENDERS_BY_VALUE",
    "name": "Top senders by total value",
    "category": "transaction_aggregation",
    "difficulty": "medium",
    "slots": {
      "n": {
        "type": "integer",
        "default_range": [
          5,
          100
        ]
      }
    },
    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT ?sender (SUM(?value) AS ?totalWei) WHERE {{\n  ?tx a :Transaction ; :hasFrom ?sender ; :hasValue ?value .\n}} GROUP BY ?sender ORDER BY DESC(?totalWei) LIMIT {n}",
    "nl_seed": "Who are the top {n} senders by total ETH value?",
    "expected_columns": [
      "sender",
      "totalWei"
    ],
    "ontology_elements": [
      ":Transaction",
      ":hasFrom",
      ":hasValue"
    ],
