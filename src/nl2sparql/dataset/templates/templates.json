[
  {
    "id": "T_COUNT_TX_IN_RANGE",
    "name": "Count transactions in time range",
    "category": "time_range",
    "difficulty": "easy",
    "slots": {
      "start_date": {
        "type": "date",
        "default_range": [
          "2024-01-01",
          "2024-12-31"
        ]
      },
      "end_date": {
        "type": "date",
        "default_range": [
          "2024-01-01",
          "2024-12-31"
        ],
        "constraint": "after start_date"
      }
    },
    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT (COUNT(?tx) AS ?count) WHERE {{\n  ?tx a :Transaction ; :hasTimestamp ?ts .\n  FILTER(?ts >= \"{start_date}T00:00:00Z\"^^xsd:dateTime)\n  FILTER(?ts < \"{end_date}T00:00:00Z\"^^xsd:dateTime)\n}}",
    "nl_seed": "How many transactions happened between {start_date} and {end_date}?",
    "expected_columns": [
      "count"
    ],
    "ontology_elements": [
      ":Transaction",
      ":hasTimestamp"
    ],
    "example_fill": {
      "start_date": "2024-01-01",
      "end_date": "2024-02-01",
      "n": 10,
      "value_wei": "1000000000000000000",
      "gas_used": 500000,
      "account": "<https://thesis.example.org/eth-kg/addr/0x1111111111111111111111111111111111111111>",
      "account_b": "<https://thesis.example.org/eth-kg/addr/0x2222222222222222222222222222222222222222>",
      "tx": "<https://thesis.example.org/eth-kg/tx/0xtx1>",
      "block_number": 19000000,
      "token_symbol": "USDC",
      "owner": "Binance",
      "category": "exchange",
      "concept_class": "ExchangeAccount",
      "window_minutes": 30
    }
  },
  {
    "id": "T_LIST_TX_FROM_ACCOUNT",
    "name": "List transactions from account",
    "category": "entity_lookup",
    "difficulty": "easy",
    "slots": {
      "account": {
        "type": "ethereum_iri"
      },
      "n": {
        "type": "integer",
        "default_range": [
          5,
          100
        ]
      }
    },
    "sparql_template": "PREFIX : <https://thesis.example.org/eth-kg/>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\nSELECT ?tx WHERE {{\n  ?tx a :Transaction ; :hasFrom {account} .\n}} LIMIT {n}",
    "nl_seed": "List {n} transactions sent by {account}.",
    "expected_columns": [
      "tx"
    ],
    "ontology_elements": [
      ":Transaction",
      ":hasFrom"
    ],
    "example_fill": {
      "start_date": "2024-01-01",
      "end_date": "2024-02-01",
      "n": 10,
      "value_wei": "1000000000000000000",
      "gas_used": 500000,
      "account": "<https://thesis.example.org/eth-kg/addr/0x1111111111111111111111111111111111111111>",
      "account_b": "<https://thesis.example.org/eth-kg/addr/0x2222222222222222222222222222222222222222>",
      "tx": "<https://thesis.example.org/eth-kg/tx/0xtx1>",
      "block_number": 19000000,
      "token_symbol": "USDC",
      "owner": "Binance",
      "category": "exchange",
      "concept_class": "ExchangeAccount",
      "window_minutes": 30
    }
  },
